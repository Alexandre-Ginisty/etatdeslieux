<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.EtatDesLieux" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/blue_primary</item>
        <item name="android:colorPrimaryDark">@color/blue_dark</item>
        <item name="android:colorAccent">@color/blue_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <color name="blue_primary">#1976D2</color>
    <color name="blue_dark">#004BA0</color>
    <color name="blue_accent">#42A5F5</color>
    <color name="white">#FFFFFF</color>
    <color name="gray_light">#F5F5F5</color>
    <color name="gray">#9E9E9E</color>
    <color name="gray_dark">#424242</color>
    <color name="black">#212121</color>
    <color name="red">#D32F2F</color>
</resources>
